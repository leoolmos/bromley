   "min_tranche": 0.1,
   "min_tranche_newer_leases": 0.05,
   "one_percent_annual_years": 15,
   "max_share": 1.0,
   "notes": "Shares of 10% or more at any time (some newer leases 5%, some older 25%), priced at a RICS valuation at the time; homes bought from 1 April 2021 may allow 1% a year for the first 15 years at an HPI-indexed price (no admin fee). Rent falls in proportion to the landlord's remaining share. Max 100% (80% in designated protected areas; 75% for older-persons shared ownership)."
  },
  "rent_review": "Annual; leases from 12 Oct 2023: RPI + up to 0.5% or CPI + 1% (never falls).",
  "sdlt_note": "SDLT: either a market value election (one-off SDLT on the FULL market value, FTB relief if that value <= GBP 500,000, nothing more on staircasing) or staged payments (SDLT on the share price only if above the threshold, plus rent NPV; more SDLT only once the share exceeds 80%).",
  "london": {
   "source_url": "https://www.london.gov.uk/programmes-strategies/housing-and-land/buying-and-owning-home/shared-ownership-scheme",
